<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app_id@</id>
  <name>@app_name@</name>
  <summary>Read and send mail</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.stalvatero">
    <name>Salvatore Oscurato</name>
  </developer>
  <description>
    <p>
      Letter is a GNOME mail client built on GTK 4 and libadwaita. It uses
      GNOME Online Accounts and Evolution Data Server, the same stack as
      Calendar and Contacts, so Google, Microsoft 365, Exchange, and IMAP
      accounts already configured on the desktop appear here without a
      second setup.
    </p>
    <p>
      Read conversations, search, compose HTML mail, and get notifications.
      Add accounts in Settings → Online Accounts. Letter needs GNOME 50 or later.
    </p>
  </description>
  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <provides>
    <mediatype>message/rfc822</mediatype>
    <mediatype>application/eml</mediatype>
  </provides>
  <url type="homepage">https://github.com/stalvatero/letter</url>
  <url type="bugtracker">https://github.com/stalvatero/letter/issues</url>
  <translation type="gettext">letter</translation>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <id>org.gnome.NautilusPreviewer</id>
  </recommends>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#1a5fb4</color>
    <color type="primary" scheme_preference="dark">#62a0ea</color>
  </branding>
  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>HighContrast</kudo>
    <kudo>ModernToolkit</kudo>
    <kudo>Notifications</kudo>
  </kudos>
  <categories>
    <category>Network</category>
    <category>Email</category>
  </categories>
  <releases>
    <release version="@version@" type="development" date="2026-09-18">
      <description>
        <p>
          Fifth 1.0 release candidate. Brazilian Portuguese translation,
          Debian/Ubuntu .deb on Releases beside Flatpak, reliable list
          selection after emptying a conversation from the current folder, and
          compose no longer autosaves drafts every two minutes (avoids
          duplicate drafts on Microsoft 365).
        </p>
      </description>
    </release>
    <release version="1.0.0-rc.4" type="development" date="2026-09-17">
      <description>
        <p>
          Fourth 1.0 release candidate. Recipient chips offer Write to and Copy
          Email; compose gains high priority, Paste and Match Style, and Space
          to commit addresses. Open and save .eml files, bulk actions in
          multi-select, quieter Archive/Sent sync, Draft tip refresh, and
          aggregate notification sound.
        </p>
      </description>
    </release>
    <release version="1.0.0-rc.3" type="development" date="2026-09-14">
      <description>
        <p>
          Third 1.0 release candidate. Soft archive, trash, move, and flags
          stay local until the sync timer, F5, startup, or quit, with an
          on-disk mutation registry so pending work survives a crash. Microsoft
          365 Archive moves are bulk and fast again (Camel freeze around
          transfer). Virtual Outbox for Send, Drafts autosave every two
          minutes, and Flatpak ships a minimal Evolution + evolution-ews stack
          for Graph mail in the sandbox.
        </p>
      </description>
    </release>
    <release version="1.0.0-rc.2" type="development" date="2026-09-09">
      <description>
        <p>
          Second 1.0 release candidate. Completes the German UI translation,
          fixes Microsoft 365 bookmarks against Outlook Flag (not High
          Importance), shows a compact badge for high-priority mail, and
          accepts localized search operators. Also includes calendar
          invitation timezone and Accept/Decline latency fixes from after rc.1.
        </p>
      </description>
    </release>
    <release version="1.0.0-rc.1" type="development" date="2026-09-08">
      <description>
        <p>
          First 1.0 release candidate. Daily-use mail with cache-first sync,
          undo for archive, move and trash, Inbox on every startup, and an
          experimental Flatpak bundle. Feedback and remaining translations
          welcome before 1.0.0.
        </p>
      </description>
    </release>
    <release version="0.9.0-beta.1" type="development" date="2026-09-03">
      <description>
        <p>First public beta: reading, composing, search, notifications, and GNOME Online Accounts.</p>
      </description>
    </release>
  </releases>
</component>
