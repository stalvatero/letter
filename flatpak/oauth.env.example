# Copy to flatpak/oauth.env and fill in (gitignored — never commit oauth.env).
# Google Cloud Console → APIs & Services → Credentials → Desktop OAuth client.
#
#   cp flatpak/oauth.env.example flatpak/oauth.env
#
# Release / CI: set the same two names as repository secrets / env vars;
# scripts/build-flatpak.sh prefers the environment over this file.

LETTER_GOOGLE_CLIENT_ID=
LETTER_GOOGLE_CLIENT_SECRET=
